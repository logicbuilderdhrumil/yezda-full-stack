# Yezda Full-Stack Environment Configuration
# Copy to .env and configure for your environment
# DO NOT commit actual secrets to version control

#==============================================================================
# CORE SETTINGS
#==============================================================================
NODE_ENV=development
# NODE_ENV=production

#==============================================================================
# JWT & AUTHENTICATION SECRETS
# IMPORTANT: Use 32+ character cryptographically random strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#==============================================================================
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=yezda-auth
JWT_AUDIENCE=yezda-api

#==============================================================================
# MULTI-FACTOR AUTHENTICATION
#==============================================================================
MFA_ENCRYPTION_KEY=dev-mfa-encryption-key-change-in-production
MFA_ISSUER=Yezda

#==============================================================================
# SECURITY SETTINGS
#==============================================================================
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=30
AUTH_PASSWORD_RESET_TTL_MINUTES=60

#==============================================================================
# RATE LIMITING
#==============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_AUTH_REQUESTS=10
RATE_LIMIT_MAX_OAUTH_REQUESTS=20

#==============================================================================
# DATABASE (PostgreSQL)
#==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yezda
DB_USER=postgres
DB_PASSWORD=
DB_MAX_CONNECTIONS=20

#==============================================================================
# REDIS (Caching & Sessions)
#==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

#==============================================================================
# OAUTH PROVIDERS
# Configure only the providers you need
#==============================================================================
OAUTH_STATE_EXPIRY_MINUTES=10
OAUTH_TOKEN_ENCRYPTION_KEY=dev-oauth-encryption-key-change-in-production
OAUTH_BASE_REDIRECT_URI=http://localhost:3000/api/v1/oauth/callback

# Google OAuth
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# GitHub OAuth
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Slack OAuth
# OAUTH_SLACK_CLIENT_ID=
# OAUTH_SLACK_CLIENT_SECRET=

#==============================================================================
# FIREBASE (Push Notifications & Auth)
#==============================================================================
FIREBASE_PROJECT_ID=dev-project-id
FIREBASE_CLIENT_EMAIL=dev@example.com
FIREBASE_PRIVATE_KEY=dev-private-key
# FIREBASE_DATABASE_URL=
# FIREBASE_STORAGE_BUCKET=

# Firebase Rate Limiting
FIREBASE_RATE_LIMIT_WINDOW_MS=60000
FIREBASE_MAX_TOKEN_REGISTRATIONS=10
FIREBASE_MAX_NOTIFICATION_DISPATCH=50

#==============================================================================
# FILE STORAGE
#==============================================================================
FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_PATH=./uploads

# S3-Compatible Storage (if FILE_STORAGE_ADAPTER=s3)
# FILE_STORAGE_S3_ENDPOINT=
FILE_STORAGE_S3_REGION=us-east-1
FILE_STORAGE_S3_BUCKET=yezda-files
# FILE_STORAGE_S3_ACCESS_KEY=
# FILE_STORAGE_S3_SECRET_KEY=
# FILE_STORAGE_S3_FORCE_PATH_STYLE=false

# File Upload Constraints
FILE_MAX_SIZE_BYTES=10485760
# FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# File Security
FILE_ENABLE_MALWARE_SCAN=false
# FILE_MALWARE_SCAN_ENDPOINT=
# FILE_MALWARE_SCAN_API_KEY=

# File Rate Limiting
FILE_RATE_LIMIT_WINDOW_MS=60000
FILE_RATE_LIMIT_MAX_UPLOADS=10
FILE_RATE_LIMIT_MAX_DOWNLOADS=100
FILE_RATE_LIMIT_MAX_METADATA=200

# File Caching
FILE_CACHE_METADATA_TTL_SECONDS=300
FILE_CACHE_ENABLE_ETAG=true

# File Retention
# FILE_DEFAULT_EXPIRATION_DAYS=
FILE_MAX_EXPIRATION_DAYS=365
